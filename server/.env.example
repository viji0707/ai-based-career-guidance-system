# Server port (Render sets this automatically; 5001 avoids the macOS ControlCenter conflict locally)
PORT=5001

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/career_guidance

# JWT settings (use a long random string in production)
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Frontend origin for CORS (only needed for split frontend/backend deploys;
# not needed for the single-service Render deploy)
CLIENT_URL=http://localhost:5173

# ---- AI provider ----
# Cloud (deployed): set GROQ_API_KEY to use Groq. GROQ_MODEL defaults to openai/gpt-oss-120b.
# Local dev: leave GROQ_API_KEY blank to use local Ollama instead.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama (only used when GROQ_API_KEY is empty)
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://127.0.0.1:11434
